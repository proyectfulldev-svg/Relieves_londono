# Copia este archivo como "secretos.properties" (en esta misma carpeta) y rellena los valores.
# secretos.properties esta en .gitignore: nunca se sube a git.

# Clave para firmar los tokens JWT (minimo 32 caracteres). Para generar una en PowerShell:
# [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SECRET=

# Administrador inicial: solo se crea si la tabla usuarios esta vacia.
ADMIN_EMAIL=
ADMIN_PASSWORD=
